@@ -296,9 +296,21 @@ inline static uint8x16_t ggml_vqtbl1q_u8(uint8x16_t a, uint8x16_t b) {
 
 #define ggml_vld1q_s16_x2 vld1q_s16_x2
 #define ggml_vld1q_u8_x2  vld1q_u8_x2
-#define ggml_vld1q_u8_x4  vld1q_u8_x4
+inline static ggml_uint8x16x4_t ggml_vld1q_u8_x4(const uint8_t *p) {
+    ggml_uint8x16x4_t r;
+    for (int i = 0; i < 4; ++i) {
+        r.val[i] = vld1q_u8(p + 16*i);
+    }
+    return r;
+}
 #define ggml_vld1q_s8_x2  vld1q_s8_x2
-#define ggml_vld1q_s8_x4  vld1q_s8_x4
+inline static ggml_int8x16x4_t ggml_vld1q_s8_x4(const int8_t *p) {
+    ggml_int8x16x4_t r;
+    for (int i = 0; i < 4; ++i) {
+        r.val[i] = vld1q_s8(p + 16*i);
+    }
+    return r;
+}
 #define ggml_vqtbl1q_s8   vqtbl1q_s8
 #define ggml_vqtbl1q_u8   vqtbl1q_u8
 
